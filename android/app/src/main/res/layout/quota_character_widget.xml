<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quota_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quota_widget_background"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/quota_character"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/quota_character_description"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/quota_character_tap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quota_character_description"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="2dp"
            android:text="点我"
            android:textColor="#9CA89F"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="剩余额度"
                android:textColor="#F4F4F5"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/quota_refresh"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/quota_widget_button"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="刷新"
                android:textColor="#E8E2D7"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quota_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="等待额度"
            android:textColor="#A1A1AA"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="短周期"
                android:textColor="#B9BAB7"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/quota_primary_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#70A57D"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="长周期"
                android:textColor="#B9BAB7"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/quota_secondary_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#6B89A6"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点角色查看额度气泡"
            android:textColor="#777B76"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
